# Einzige Quelle fuer die Werte der lokalen Entwicklungsumgebung.
#
# Committet, weil diese Zugangsdaten ausschliesslich lokal gelten, bewusst trivial sind
# und diese Maschine nicht verlassen. Fuer jede andere Umgebung gilt CLAUDE.md §13:
# HashiCorp Vault (siehe PROD-008, PROD-010).
#
# Wer hier etwas aendert, muss infra/local/postgres/init/01-databases.sql mitziehen -
# SQL kann keine Umgebungsvariablen lesen. Das ist die einzige verbleibende Doppelung.

PORT=3001
DATABASE_URL=postgresql://requirement:requirement@localhost:5432/requirement
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/infrademand
KEYCLOAK_AUDIENCE=requirement-api
