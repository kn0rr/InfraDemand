{
  "realm": "infrademand",
  "displayName": "InfraDemand",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,

  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "Vollzugriff auf die Plattformverwaltung" },
      { "name": "requirement-author", "description": "Darf Anforderungen anlegen und bearbeiten" },
      { "name": "requirement-reader", "description": "Darf Anforderungen lesen" }
    ]
  },

  "clients": [
    {
      "clientId": "requirement-api",
      "name": "Requirement Service (Zielgruppe)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "frontend",
      "name": "InfraDemand Web-Oberflaeche",
      "enabled": true,
      "publicClient": false,
      "secret": "$(env:FRONTEND_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/api/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/"
      },
      "protocolMappers": [
        {
          "name": "audience-requirement-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "requirement-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenants",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenants",
            "claim.name": "tenants",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "test-cli",
      "name": "Nur fuer Tests und CI: Passwort-Grant",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-requirement-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "requirement-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "tenants",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenants",
            "claim.name": "tenants",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "test.author",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Author",
      "email": "test.author@example.local",
      "credentials": [{ "type": "password", "value": "test", "temporary": false }],
      "realmRoles": ["requirement-author"],
      "attributes": { "tenants": ["t-eins", "t-zwei"] }
    },
    {
      "username": "test.admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Admin",
      "email": "test.admin@example.local",
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ],
      "realmRoles": ["platform-admin"],
      "attributes": { "tenants": ["t-eins", "t-zwei"] }
    }
  ]
}
