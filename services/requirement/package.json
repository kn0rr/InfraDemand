{
  "name": "@infrademand/requirement",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e ../../infra/local/local.env -- drizzle-kit migrate",
    "api:generate": "nest build && node dist/openapi.export.js && pnpm -w run api:lint"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "jwks-rsa": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.47",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "js-yaml": "^5.2.3",
    "jsonwebtoken": "^9.0.3",
    "supertest": "^7.2.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  }
}
